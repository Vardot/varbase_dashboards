{
  "name": "varbase_dashboards",
  "description": "This dashboard is built on top of Dashboards with Layout Builder module, utilize Drupal core's Layout Builder for dynamic dashboards management, Google Analytics Reports, and several enhanced blocks and widgets for an intuitive and flexible administration experience.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "scripts": {
    "theme:build": "webpack --progress --config webpack.config.build.js && stylelint \"css/**/*.css\" --fix",
    "theme:watch": "webpack --progress --config webpack.config.dev.js --watch",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint ."
  },
  "keywords": [
    "SASS",
    "Drupal",
    "Varbase",
    "Dashboard",
    "Admin Dashboard"
  ],
  "author": "Vardot",
  "devDependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.39.0",
    "cspell": "^8.16.1",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "expose-loader": "^5.0.0",
    "glob": "^11.0.0",
    "jquery": "~3.7.0",
    "jquery-form": "4.3.x",
    "jquery-ui": "1.13.x",
    "js-cookie": "3.0.x",
    "jsdom": "^26.1.0",
    "loadjs": "^4.3.0",
    "mini-css-extract-plugin": "^2.9.2",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "nightwatch": "^3.10.1",
    "normalize.css": "8.0.x",
    "postcss": "^8.4.49",
    "postcss-header": "^3.0.3",
    "postcss-import": "^16.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.1.5",
    "postcss-pxtorem": "^6.1.0",
    "postcss-rtlcss": "^4.0.9",
    "postcss-sorting": "^9.1.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.4.2",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "sass-resources-loader": "^2.2.5",
    "shepherd.js": "~10.0.1",
    "sortablejs": "1.15.x",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-order": "^6.0.4",
    "stylelint-webpack-plugin": "^5.0.1",
    "svg-spritemap-webpack-plugin": "^4.5.0",
    "tabbable": "~6.0.0",
    "terser": "^5.37.0",
    "terser-webpack-plugin": "^5.3.11",
    "underscore": "~1.13.4",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-merge": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid version",
    "last 1 Samsung version",
